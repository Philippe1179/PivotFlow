# Required for the /contact form to send email (src/app/api/contact/route.ts).
# Get a key at https://resend.com after creating an account.
RESEND_API_KEY=

# Optional: the "from" address contact form emails are sent as. Defaults to
# Resend's shared sandbox address, which works without domain verification.
# Once pivotflowlabs.com is verified in Resend, switch this to an address on
# that domain (e.g. "PivotFlow Labs <contact@pivotflowlabs.com>") for better
# deliverability.
CONTACT_FROM_EMAIL=
